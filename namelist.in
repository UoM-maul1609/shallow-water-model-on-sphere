
 &run_vars
 	nm1%inputfile  = 'saturn_winds_vs_latitude_update.nc'
	nm1%outputfile = '/tmp/output.nc',
	nm1%add_random_height_noise=.true.,
	nm1%height_noise_scheme=1, ! 0=legacy grid-cell noise (default), 1=correlated physical-scale noise
	nm1%height_noise_amplitude=200., ! RMS metres; used only for height_noise_scheme=1
	nm1%height_noise_corr_length=5.e5, ! horizontal Gaussian sigma in metres; scheme=1
	nm1%height_noise_lat_sigma=2.0, ! latitude-envelope sigma in degrees; scheme=1 (1 jet width for current analytic jet)
	nm1%initially_geostrophic=.true.,
	nm1%subgrid_model=2, ! 1 = constant viscosity, 2=smagorinsky
    nm1%smagorinsky_scheme=1, ! 0=legacy Smagorinsky (default), 1=spherical conservative SGS stress
	nm1%coriolis_scheme=1, ! 0=legacy/original (default), 1=Crank-Nicolson
	nm1%momentum_metric_terms=1, ! 0=legacy/off (default), 1=spherical curvature + gradient-wind init
	nm1%lat_boundary_scheme=2, ! 0=legacy frozen ghosts, 1=free-slip wall, 2=radiative/open
	nm1%sponge_south_width=5., ! degrees inward from the actual southern model latitude; 0 disables
	nm1%sponge_south_timescale=43200., ! seconds at boundary; 0 disables southern sponge
	nm1%sponge_north_width=2.5, ! degrees inward from the actual northern model latitude; 0 disables
	nm1%sponge_north_timescale=43200., ! seconds at boundary; 0 disables northern sponge
	nm1%viscous_dissipation=.true.,
	nm1%dissipate_h=.false.,
	nm1%initial_winds=2,  ! 1==saturn_winds, 2==idealised_jet
	nm1%u_jet=55.,  ! speed of jet
	nm1%theta_jet=73., ! latitude of jet
	nm1%h_jet=1., ! standard deviation of jet (width)
	nm1%nudge=.true.,
	nm1%nudge_scheme=0, ! 0=legacy/default, 1=nudge global zonal-mean u only
	nm1%nudge_timescale=6.e5, ! default 6.e5 seconds (about 7 days) (1.728e6=20 days)
	nm1%restart=.false.,
	nm1%wind_factor=1.0,
	nm1%wind_shift=0.0,
	nm1%wind_reduce=0.0,
	nm1%vis=0.e6,
	nm1%cvis=0.15, ! usually between 0.1 and 0.2
	nm1%vis_eq=1.e8, ! viscosity for v over equator region
	nm1%lat_eq=20., ! latitude north and south over which to apply vis_eq
	nm1%runtime= 7776000, !15552000., !7776000.,
	nm1%dt=60.,
	nm1%output_interval=57600.,
	nm1%grav=10.44,		! gravity
	nm1%rho=0.19,		! density
	nm1%Re=5.45e7, ! radius of Saturn at around 77 N
!	nm1%rotation_period_hours=10.55,
	nm1%rotation_period_hours=10.6564,
	nm1%scale_height=60.e3, ! scale-height of saturn's atmosphere (m)
						! it's actuall SW equivalent depth, not literal scale height
						! so might need to try 10,20,40, 60km
	nm1%ip=400,
	nm1%jp=120,
	nm1%slat=-90.,
	nm1%nlat=90.,
	nm1%slat_thresh=45.,
	nm1%nlat_thresh=86.5/
